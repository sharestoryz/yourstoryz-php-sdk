{
    "name": "sharestoryz/yourstoryz-php-sdk",
    "description": "An SDK to easily work with the YourStoryz API",
    "keywords": [
        "sharestoryz",
        "yourstoryz-php-sdk"
    ],
    "homepage": "https://github.com/sharestoryz/yourstoryz-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Henk Hazelaar",
            "email": "janhenk@concept7.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "YourStoryz\\PhpSdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourStoryz\\PhpSdk\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
